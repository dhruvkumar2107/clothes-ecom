# ─────────────────────────────────────────────────────────────────────────────
# LUMEN&CO — Environment Variables
# Copy to .env and fill in. Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Database (Postgres via Neon)
# Use Neon's pooled endpoint for application requests and the unpooled endpoint
# for Prisma schema operations. Copy both URLs from the Neon project dashboard.
# Replace placeholders and URL-encode special characters in the password.
# statement_cache_size=0 avoids stale prepared statements through the pooler.
DATABASE_URL="postgresql://<role>:<encoded-password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require&pgbouncer=true&statement_cache_size=0&connection_limit=5&pool_timeout=20"
DIRECT_URL="postgresql://<role>:<encoded-password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="LUMEN&CO"
NODE_ENV="development"

# Auth
JWT_SECRET="dev-secret-change-in-production-min-32-chars"
# Required: generate a unique value with node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
SESSION_COOKIE_NAME="lmn_session"
SESSION_MAX_AGE="2592000" # 30 days

# Email (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASSWORD="password"
SMTP_FROM="LUMEN&CO <noreply@lumenandco.example>"

# SMS (Twilio / MSG91)
SMS_PROVIDER="mock" # mock | twilio | msg91
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# Payments
PAYMENT_PROVIDER="mock" # mock | razorpay | stripe
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# RazorpayX Payouts
RAZORPAYX_KEY_ID=""
RAZORPAYX_KEY_SECRET=""

# Cashfree Payouts
CASHFREE_CLIENT_ID=""
CASHFREE_CLIENT_SECRET=""

# Bank Verification
BANK_VERIFICATION_PROVIDER="mock" # mock | razorpay | cashfree | decentro
DECENTRO_CLIENT_ID=""
DECENTRO_CLIENT_SECRET=""
DECENTRO_MODULE_SECRET=""

# Webhooks
WEBHOOK_SECRET="dev-webhook-secret"

# Referral
REFERRAL_WELCOME_COUPON="WELCOME10"
REFERRAL_COMMISSION_PERCENT="7.5"
REFERRAL_HOLD_DAYS="14"

# Feature flags
ENABLE_GRAIN="true"
ENABLE_AR="false"
ENABLE_360="false"

# Storage — Cloudinary (recommended for Render deployments)
# Local uploads are lost on every Render restart; use Cloudinary for persistent storage.
STORAGE_PROVIDER="cloudinary" # local | s3 | cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CDN_URL="" # Optional: your Cloudinary CDN custom domain or Cloudflare R2 endpoint

# Upstash Redis (optional but recommended for homepage caching)
# Sign up at https://upstash.com — free tier: 10,000 commands/day, 1 GB storage.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
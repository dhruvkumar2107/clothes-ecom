# ─────────────────────────────────────────────────────────────────────────────
# LUMEN&CO — Environment Variables
# Copy to .env and fill in. Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Database (SQLite for dev, Postgres for prod)
DATABASE_URL="file:./dev.db"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="LUMEN&CO"
NODE_ENV="development"

# Auth
JWT_SECRET="dev-secret-change-in-production-min-32-chars"
SESSION_COOKIE_NAME="lmn_session"
SESSION_MAX_AGE="2592000" # 30 days

# Email (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASSWORD="password"
SMTP_FROM="LUMEN&CO <noreply@lumenandco.example>"

# SMS (Twilio / MSG91)
SMS_PROVIDER="mock" # mock | twilio | msg91
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# Payments
PAYMENT_PROVIDER="mock" # mock | razorpay | stripe
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# RazorpayX Payouts
RAZORPAYX_KEY_ID=""
RAZORPAYX_KEY_SECRET=""

# Cashfree Payouts
CASHFREE_CLIENT_ID=""
CASHFREE_CLIENT_SECRET=""

# Bank Verification
BANK_VERIFICATION_PROVIDER="mock" # mock | razorpay | cashfree | decentro
DECENTRO_CLIENT_ID=""
DECENTRO_CLIENT_SECRET=""
DECENTRO_MODULE_SECRET=""

# Webhooks
WEBHOOK_SECRET="dev-webhook-secret"

# Referral
REFERRAL_WELCOME_COUPON="WELCOME10"
REFERRAL_COMMISSION_PERCENT="7.5"
REFERRAL_HOLD_DAYS="14"

# Feature flags
ENABLE_GRAIN="true"
ENABLE_AR="false"
ENABLE_360="false"